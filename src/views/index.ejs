<h1>Blog Posts</h1>
<% if (posts.length > 0) { %>
<ul class="list-unstyled">
  <% posts.forEach(post => { %>
  <li class="mb-3">
    <div class="d-flex align-items-center justify-content-between">
      <a href="/post/<%= post.slug %>" class="h5 mb-0"><%= post.title %></a>
      <div>
        <a href="/post/<%= post.slug %>/edit" class="btn btn-primary btn-sm">Edit</a>
        <a href="/post/<%= post.slug %>/delete" class="btn btn-danger btn-sm ms-2">Delete</a>
      </div>
    </div>
  </li>
  <% }) %>
</ul>
<% } else { %>
<p>There are no blog posts yet. Why not <a href="/post/new">create one</a>?</p>
<% } %>
