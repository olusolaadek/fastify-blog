<div class="row justify-content-center mt-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <h3 class="card-title">Delete Post</h3>
        <p>Are you sure you want to delete the post "<strong><%= post.title %></strong>"?</p>
        <form action="/post/<%= post.slug %>/delete" method="post" style="display:inline">
          <button type="submit" class="btn btn-danger">Confirm Delete</button>
        </form>
        <a href="/post/<%= post.slug %>" class="btn btn-secondary ms-2">Cancel</a>
      </div>
    </div>
  </div>
</div>
